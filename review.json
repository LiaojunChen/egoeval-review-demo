{
  "schema_version": "1.0",
  "title": "EgoEval 20 Episode Review Demo",
  "sources": [
    "egodex_20_results"
  ],
  "metric_specs": {
    "V1": {
      "name": "模糊帧占比",
      "stage": "S1",
      "description": "把 Laplacian 清晰度与模糊阈值叠加，红色区段是不可读帧。"
    },
    "V2": {
      "name": "抖动/跟踪失效帧占比",
      "stage": "S1",
      "description": "把相邻帧光流位移与失效阈值叠加，红色区段是跟踪失败或位移过大。"
    },
    "M1": {
      "name": "硬速度阈值超限步占比",
      "stage": "S2",
      "description": "比较相机、左右腕速度，定位速度阈值超限的突发步。"
    },
    "M2": {
      "name": "平滑度合格窗口比例",
      "stage": "S2",
      "description": "同时看状态速度和加速度尖峰，直观看平滑度窗口是否被破坏。"
    },
    "M3": {
      "name": "轨迹连续性异常步占比",
      "stage": "S2",
      "description": "轨迹连续性残差与左右腕速度并列，异常尖峰对应断裂/跳变。"
    },
    "M4": {
      "name": "操作窗口空闲率",
      "stage": "S2",
      "description": "状态运动与视频运动能量同时接近低值的区段是空闲段。"
    },
    "C1": {
      "name": "语义一致性",
      "stage": "S3",
      "description": "原始证据与评级结果并列展示。"
    },
    "C2": {
      "name": "有效手帧比例",
      "stage": "S3",
      "description": "展示左右手帧级置信度，低于有效帧阈值的区段会暴露出来。"
    },
    "C3": {
      "name": "手姿态置信度",
      "stage": "S3",
      "description": "展示左右手姿态置信度的时间变化，而不是只看 episode 中位数。"
    },
    "X1": {
      "name": "指令-视频一致性",
      "stage": "S4",
      "description": "指令文本与视频并置，人工核对动作、对象、目标、方向、顺序和结果。"
    },
    "X2": {
      "name": "视频-状态一致性",
      "stage": "S4",
      "description": "将状态运动与视频运动能量归一化叠加，检查视频变化是否被状态解释。"
    },
    "X3": {
      "name": "时间戳完整率",
      "stage": "S4",
      "description": "时间戳间隔与期望帧间隔叠加，直接显示丢帧或大间隔。"
    },
    "X4": {
      "name": "跨模态绝对滞后",
      "stage": "S4",
      "description": "视频运动与状态运动叠加，结合 details 中的 lag/drift 判断跨模态偏移。"
    },
    "X5": {
      "name": "状态-动作方向一致率",
      "stage": "S4",
      "description": "状态-动作方向需要独立 action 流；缺失时明确显示证据不足。"
    }
  },
